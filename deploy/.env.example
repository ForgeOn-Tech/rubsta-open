# Deployment configuration. Copy to deploy/.env (ignored by Git).
RUBSTA_PROJECT=forgeon
RUBSTA_ZONE=asia-south1-a
RUBSTA_HOST=
RUBSTA_TLS_EMAIL=tech@forgelabs.in
RUBSTA_ASSET_BUCKET=
# Full git SHA, matching both the app image and the GCS release prefix.
RUBSTA_RELEASE=
# Choose explicitly: internal or public.
RUBSTA_ACCESS_MODE=
# Required for internal previews. Generate a bcrypt hash using caddy hash-password.
# In .env, single-quote the hash so Compose preserves literal dollar signs.
RUBSTA_PREVIEW_USER=
RUBSTA_PREVIEW_PASSWORD_HASH=
