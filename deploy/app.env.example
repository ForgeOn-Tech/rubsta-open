# Copy to deploy/.env.app (ignored by Git). Never copy the developer demo DB.
AUTH_SECRET=
DEMO_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# Optional team password login. Add admin-password@rubstaopen.invalid to
# ADMIN_EMAILS as well. Generate securely with scripts/create-admin-login.mjs.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_VERSION=
UMPIRE_EMAILS=
# Keep these empty until payment setup for this deployment is verified.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional adult player avatars. Configure securely in deploy/.env.app.
OPENAI_API_KEY=
