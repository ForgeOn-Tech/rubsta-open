{
  email {$RUBSTA_TLS_EMAIL}
}

{$RUBSTA_HOST} {
  import /etc/caddy/access.caddy
  root * /srv/site

  @homepage path / /index.html
  handle @homepage {
    rewrite * /index.html
    header Cache-Control "no-cache"
    file_server
  }

  handle /assets/* {
    header Cache-Control "no-cache"
    file_server
  }

  handle {
    reverse_proxy app:3100
  }
}
