# Auth.js (next-auth v5). Required, in dev too: sign-in fails with a server
# configuration error without it. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set to true when the app runs behind a proxy (Docker, Cloud Run, Fly).
AUTH_TRUST_HOST=true

# Google OAuth. When both are set, "Continue with Google" appears on /signin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite database file. Defaults to ./data/tournament.db (gitignored).
DATABASE_PATH=

# Comma-separated emails allowed into /admin. Nobody else gets in, including in
# demo mode. To use /admin locally, list demo@rubstaopen.local here.
ADMIN_EMAILS=

# Comma-separated emails allowed to score matches at /score, without access to
# /admin. Admins can always score.
UMPIRE_EMAILS=

# Demo mode: enables a "Continue with demo account" sign-in (demo@rubstaopen.local).
DEMO_AUTH=true

# Razorpay payments. With both keys empty, payments are off: registration ends
# at "Submit entry" and the entry stays submitted. With both set, the player pays
# the event's fee through Razorpay Checkout right after submitting. Use test keys
# (rzp_test_...) from Dashboard > Account & Settings > API Keys until go-live.
# The key secret stays on the server; never give it a NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Secret for the webhook at /api/payments/razorpay/webhook, set in Dashboard >
# Webhooks with the payment.captured and order.paid events. Without it the
# webhook answers 503, and entries are marked paid only when Checkout reports back.
RAZORPAY_WEBHOOK_SECRET=

# Optional photo-to-tennis-avatar generation. Server-only; never NEXT_PUBLIC_.
# Requires OpenAI API billing/model access. Blank disables generation safely.
OPENAI_API_KEY=
