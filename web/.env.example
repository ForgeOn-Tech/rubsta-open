# Auth.js (next-auth v5). Required in production (`next start`); dev works
# without it. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set to true when the app runs behind a proxy (Docker, Cloud Run, Fly).
AUTH_TRUST_HOST=true

# Google OAuth. When both are set, "Continue with Google" appears on /signin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite database file. Defaults to ./data/tournament.db (gitignored).
DATABASE_PATH=

# Comma-separated emails allowed to view /entries (organiser view).
# ENTRIES_ADMIN_EMAILS=draws@rubstaopen.local,organiser@example.com
ENTRIES_ADMIN_EMAILS=

# Demo mode: enables a "Continue with demo account" sign-in (demo@rubstaopen.local).
# Also lets any signed-in user view /entries (prototype access control).
DEMO_AUTH=true

# Payment integration. When not "true", registration ends at "Submit entry"
# (status: submitted, no payment). When "true", a Razorpay-style stub UI is
# shown; no real payment is processed (paymentRef: razorpay-stub).
NEXT_PUBLIC_PAYMENTS_ENABLED=false
